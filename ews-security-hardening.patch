diff --git a/migrations/0009_node_request_nonces.sql b/migrations/0009_node_request_nonces.sql
new file mode 100644
index 0000000..bb7d58d
--- /dev/null
+++ b/migrations/0009_node_request_nonces.sql
@@ -0,0 +1,10 @@
+CREATE TABLE IF NOT EXISTS node_request_nonces (
+  node_id TEXT NOT NULL,
+  request_id TEXT NOT NULL,
+  received_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY (node_id, request_id),
+  FOREIGN KEY (node_id) REFERENCES nodes(node_id) ON DELETE CASCADE
+);
+
+CREATE INDEX IF NOT EXISTS idx_node_request_nonces_received
+ON node_request_nonces(received_at);
